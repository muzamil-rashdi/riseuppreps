# Database
POSTGRES_USER=rupa_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=rupa_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# JWT
JWT_ACCESS_SECRET=change_this_to_a_random_64_char_string
JWT_REFRESH_SECRET=change_this_to_another_random_64_char_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Backend
NODE_ENV=production
PORT=4000
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost

# Email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="RiseUp Preps Academy <your_email@gmail.com>"

# Admin Seed
ADMIN_EMAIL=admin@riseuppreps.org
ADMIN_PASSWORD=change_me_admin_password
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
