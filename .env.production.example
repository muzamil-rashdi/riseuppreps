# Database — use a strong password in production!
POSTGRES_USER=rupa_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=rupa_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://rupa_user:CHANGE_ME_STRONG_PASSWORD@postgres:5432/rupa_db

# JWT — generate random 64-char strings: openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_ME_RANDOM_64_CHAR_STRING
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_RANDOM_64_CHAR_STRING
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Backend
NODE_ENV=production
PORT=4000
BACKEND_URL=https://riseupprepsacademy.com/api
FRONTEND_URL=https://riseupprepsacademy.com

# Email (Hostinger SMTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=admin@riseupprepsacademy.com
SMTP_PASS=CHANGE_ME_EMAIL_PASSWORD
SMTP_FROM=admin@riseupprepsacademy.com

# Admin Seed
ADMIN_EMAIL=admin@riseuppreps.org
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=RiseUp

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
